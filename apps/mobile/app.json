{
  "expo": {
    "name": "rdc",
    "slug": "rdc-mobile",
    "version": "0.0.1",
    "scheme": "rdc",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.rdc.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.rdc.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "rdc connects to your development machine on your local network."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "rdc uses the camera only to scan the pairing QR code shown on your computer."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ddba29c9-3ecb-4141-ae98-bb427035dfdd"
      }
    },
    "owner": "piyushptiwari"
  }
}

{
  "name": "relay-by-bytical",
  "displayName": "Relay by Bytical",
  "description": "Control your dev machine and AI coding agents from your phone. One-click setup: this extension installs and runs the Relay controller, then pairs your phone with a QR code \u2014 end-to-end encrypted.",
  "version": "0.2.4",
  "private": true,
  "publisher": "bytical",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/piyushptiwari1/bytical-relay.git"
  },
  "homepage": "https://relay.bytical.ai",
  "keywords": [
    "remote",
    "phone",
    "agents",
    "copilot",
    "mobile"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "relay.setup",
        "title": "Relay: Set up this computer"
      },
      {
        "command": "relay.pair",
        "title": "Relay: Pair phone"
      },
      {
        "command": "relay.menu",
        "title": "Relay: Menu"
      },
      {
        "command": "relay.feedback",
        "title": "Relay: Send feedback"
      },
      {
        "command": "relay.stop",
        "title": "Relay: Stop controller"
      },
      {
        "command": "relay.logs",
        "title": "Relay: Show logs"
      },
      {
        "command": "rdc.reconnect",
        "title": "Relay: Reconnect to controller"
      },
      {
        "command": "rdc.openAgents",
        "title": "Relay: Open in Agents"
      }
    ],
    "configuration": {
      "title": "Relay",
      "properties": {
        "relay.appPath": {
          "type": "string",
          "default": "",
          "description": "Existing Relay checkout to use instead of the extension-managed install (for contributors)."
        },
        "relay.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the Relay controller automatically when VS Code opens."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "relay-sidebar",
          "title": "Relay",
          "icon": "media/relay-icon.svg"
        }
      ]
    },
    "views": {
      "relay-sidebar": [
        {
          "id": "relayHome",
          "name": "Phone control",
          "icon": "media/relay-icon.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "relay.gettingStarted",
        "title": "Control this computer from your phone",
        "description": "Three steps: set up, pair, and hand work to your pocket.",
        "steps": [
          {
            "id": "relay.step.setup",
            "title": "Set up this computer",
            "description": "Relay installs and runs its controller for you.\n[Set up](command:relay.setup)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onCommand:relay.setup"
            ]
          },
          {
            "id": "relay.step.pair",
            "title": "Pair your phone",
            "description": "Scan one QR \u2014 same Wi-Fi once, then anywhere.\n[Pair phone](command:relay.pair)",
            "media": {
              "markdown": "media/walkthrough/pair.md"
            },
            "completionEvents": [
              "onCommand:relay.pair"
            ]
          },
          {
            "id": "relay.step.agents",
            "title": "Start work, follow from your phone",
            "description": "Hand the active workspace to an agent.\n[Open in Agents](command:rdc.openAgents)",
            "media": {
              "markdown": "media/walkthrough/agents.md"
            },
            "completionEvents": [
              "onCommand:rdc.openAgents"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && vsce package --no-dependencies",
    "publish:marketplace": "pnpm build && vsce publish --no-dependencies"
  },
  "dependencies": {
    "@rdc/protocol": "workspace:*",
    "@rdc/shared": "workspace:*",
    "@rdc/transport": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.4.0",
    "esbuild": "^0.28.0",
    "typescript": "catalog:"
  }
}

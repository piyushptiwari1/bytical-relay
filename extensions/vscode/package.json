{
  "name": "rdc-vscode",
  "displayName": "Remote Dev Control",
  "description": "Publishes editor presence (active file, diagnostics, tasks, terminal commands) to the local rdc controller so your phone can see and drive VS Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "rdc",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "rdc.reconnect",
        "title": "RDC: Reconnect to controller"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rdc/protocol": "workspace:*",
    "@rdc/shared": "workspace:*",
    "@rdc/transport": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.101.0",
    "esbuild": "^0.28.0",
    "typescript": "catalog:"
  }
}
